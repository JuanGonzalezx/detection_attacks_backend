# ---- WhatsApp Cloud API (Meta) ----
# ID numerico del numero (NO el numero visible). App -> WhatsApp -> API Setup -> "From Phone Number ID"
WHATSAPP_PHONE_NUMBER_ID=
# Token de acceso. Para la 1a prueba sirve el temporal (24h); ideal el permanente (System User).
WHATSAPP_ACCESS_TOKEN=
# Secreto que inventas tu; debe coincidir con el "Verify Token" que pongas en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=cedula_fraude_2026_xyz
# Version del Graph API.
WHATSAPP_API_VERSION=v22.0
# Opcional. App Settings -> Basic -> App Secret. Si se llena, se valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# ---- Endpoint del Lambda (deteccion de fraude / Rekognition) ----
FRAUD_API_URL=https://6v39g0i9ga.execute-api.us-east-1.amazonaws.com/upload-image

# ---- Supabase Postgres (estado de la conversacion) ----
# Usa la cadena del "Transaction pooler" (host *.pooler.supabase.com, puerto 6543), NO la directa 5432.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
